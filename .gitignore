# Secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
tokens/

# Client personal data: records and attachments fetched from the data source,
# captures. Never in the repo (L-004)
runtime/
tmp/
downloads/
*.pdf
*.p7m
# Exception: documentation-only PDFs
!docs/**/*.pdf

# Signature images (sensitive assets): never in the repo
signatures/
assets/signatures/

# Python (possible skill venvs)
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Runtime / logs
logs/
*.log
runs/

# Browser capture output (screenshots/snapshots/html: real data)
.playwright-mcp/

# Local Claude Code config (machine-specific permissions)
.claude/settings.local.json
