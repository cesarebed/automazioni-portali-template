# Automazioni Portali — configurazione locale (riempire in .env, MAI committare)

# ---------------------------------------------------------------------------
# Fonte dati (CRM/gestionale)
# ---------------------------------------------------------------------------
# Id dell'adapter registrato in scripts/bot/lib/crm/index.js. Si crea con la skill
# onboarding-crm (partendo da scripts/bot/lib/crm/adapters/_template.js).
CRM_ADAPTER=

# Le credenziali dell'adapter le definisce l'adapter stesso: aggiungerle qui sotto
# durante l'onboarding della fonte dati. Esempi tipici:
# CRM_BASE_URL=
# CRM_API_TOKEN=
# CRM_CLIENT_ID=
# CRM_CLIENT_SECRET=
# CRM_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Chrome dedicato via CDP (scripts/chrome-cdp/launch-chrome-cdp.sh)
# ---------------------------------------------------------------------------
# Il bot si aggancia qui invece di aprire un browser suo: le sessioni di login (2FA)
# dei portali restano vive tra un run e l'altro.
CDP_URL=http://127.0.0.1:9222

# Le credenziali di login ai portali NON vanno in chiaro qui: il login lo fa
# l'operatore a mano nel Chrome dedicato (handoff 2FA, L-001).

# ---------------------------------------------------------------------------
# Portali (sezioni aggiunte dall'onboarding, un blocco per portale)
# ---------------------------------------------------------------------------
# es.:
# <PORTALE>_PORTAL_URL=
