# Portal automation - local configuration (fill in .env, NEVER commit it)

# ---------------------------------------------------------------------------
# Data source (CRM / ERP / internal API)
# ---------------------------------------------------------------------------
# Id of the adapter registered in scripts/bot/lib/crm/index.js. Created with the
# crm-onboarding skill (starting from scripts/bot/lib/crm/adapters/_template.js).
CRM_ADAPTER=

# The adapter's credentials are defined by the adapter itself: add them below
# during data-source onboarding. Typical examples:
# CRM_BASE_URL=
# CRM_API_TOKEN=
# CRM_CLIENT_ID=
# CRM_CLIENT_SECRET=
# CRM_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Dedicated Chrome over CDP (scripts/chrome-cdp/launch-chrome-cdp.sh)
# ---------------------------------------------------------------------------
# The bot attaches here instead of launching its own browser: portal login
# sessions (including 2FA) survive between runs.
CDP_URL=http://127.0.0.1:9222

# Portal login credentials do NOT go here in plain text: the operator logs in
# manually in the dedicated Chrome (2FA handoff, L-001).

# ---------------------------------------------------------------------------
# Portals (sections added by onboarding, one block per portal)
# ---------------------------------------------------------------------------
# e.g.:
# <PORTAL>_PORTAL_URL=
